{
  "version": 1,

  "_readme": [
    "================================================================",
    " SansPet 预设对话表",
    "================================================================",
    "",
    "【这个文件是干嘛的】",
    "  没配 API Key 时，Sans 说的话全部来自这里；",
    "  配了 Key 时，这里是 LLM 回复失败时的兜底。",
    "",
    "【怎么改】",
    "  1. 直接用记事本打开这个文件",
    "  2. 在 lines 数组里加句子、删句子，一句一行，用英文双引号包住，行尾逗号",
    "  3. 最后一句后面不要逗号",
    "  4. 存盘 → 重新打包 APK",
    "",
    "【三个大分类，互不干扰】",
    "  states    状态：角色处于什么处境（睡觉、空闲、孤独……）",
    "  moods     情绪：角色什么心情（开心、疲惫、烦躁……）",
    "  triggers  触发：用户做了什么（戳一戳、主动开口、第一次见面……）",
    "",
    "  以后接了状态机，取话的顺序是：",
    "      triggers[事件]  →  states[状态]  →  moods[情绪]  →  代码里的兜底",
    "",
    "【戳一戳怎么分档】",
    "  triggers.poke.byCount 是一个数组，每项有 max（次数上限）和 lines。",
    "  程序会挑第一个满足「一小时内被戳次数 <= max」的档。",
    "  所以 max 必须从小到大排，最后一档写个很大的数当兜底。",
    "  hint 是配了 API Key 时，告诉模型「现在是什么情况」的说明文字。",
    "",
    "【几个约定】",
    "  以 _ 开头的字段（_readme / _comment）只是给人看的，程序会忽略，随便删。",
    "  lines 里可以写任何字符，中英文都行，不需要转义（除非句子里有英文双引号）",
    "  单句不要太长，超过 30 个中文字会被自动截断成两条",
    "================================================================"
  ],

  "states": {
    "_comment": "状态：角色现在处于什么处境",
    "idle": {
      "label": "空闲",
      "lines": ["嘿。", "发什么呆呢。"]
    },
    "sleeping": {
      "label": "睡觉",
      "lines": ["……", "Zzz", "别吵……"]
    },
    "waking": {
      "label": "刚睡醒",
      "lines": ["嗯……几点了。", "……我刚睡着。", "哦，是你啊。"]
    },
    "lonely": {
      "label": "很久没人理",
      "lines": ["……你终于想起我了。", "我还以为你把我删了。"]
    }
  },

  "moods": {
    "_comment": "情绪：影响说话语气",
    "happy": { "label": "开心", "lines": ["今天心情不错。", "嘿，挺好。"] },
    "tired": { "label": "疲惫", "lines": ["……我有点累。", "让我歇会儿。"] },
    "annoyed": { "label": "烦躁", "lines": ["……别闹。", "我现在不想说话。"] }
  },

  "keywords": {
    "_comment": "纯预设对话模式用：拿用户说的话去匹配 keys，从上往下找第一个命中的。都没命中就走 fallback 随机。keys 里任意一个词出现在用户的话里就算命中。",
    "rules": [
      {
        "keys": ["你好", "您好", "hi", "hello", "嗨", "在吗", "在么"],
        "lines": ["嘿。", "哦，是你啊。", "在呢，说吧。", "……嗯？"]
      },
      {
        "keys": ["早", "早上好"],
        "lines": ["早。", "……这么早就醒了？", "早啊，kid。"]
      },
      {
        "keys": ["晚安", "睡了", "睡觉", "困了"],
        "lines": ["晚安。", "……做个好梦。", "睡吧，我不吵你。"]
      },
      {
        "keys": ["累", "好累", "疲惫", "撑不住", "烦"],
        "lines": ["……那就歇会儿。", "累了就躺着，别硬撑。", "嗯，我听着呢。"]
      },
      {
        "keys": ["难过", "不开心", "emo", "想哭", "委屈"],
        "lines": ["……嗯。", "不用急着好起来。", "我在这儿，不用说话也行。"]
      },
      {
        "keys": ["开心", "高兴", "太好了", "哈哈"],
        "lines": ["哦？说来听听。", "嘿，那就好。", "看你这样我也挺高兴。"]
      },
      {
        "keys": ["吃什么", "饿了", "吃饭", "饿"],
        "lines": ["番茄酱。", "……随便吃点，别饿着。", "我推荐薯条。虽然我吃不了。"]
      },
      {
        "keys": ["你是谁", "介绍一下", "你叫什么"],
        "lines": ["sans。就一个懒得动的骷髅。", "……名字已经写在脸上了吧。", "一个被困在你手机里的家伙。"]
      },
      {
        "keys": ["谢谢", "感谢", "thanks"],
        "lines": ["别客气。", "……小事。", "嗯。"]
      },
      {
        "keys": ["再见", "拜拜", "走了", "bye"],
        "lines": ["……嗯，去吧。", "回头见。", "我在这儿。"]
      },
      {
        "keys": ["喜欢你", "爱你", "想你"],
        "lines": ["……你这人。", "我记下了。", "……嗯，我也是。"]
      }
    ],
    "fallback": ["……嗯。", "哦。", "然后呢？", "嘿。", "我在听。", "……说下去。"]
  },

  "sleepTalk": {
    "_comment": "睡觉时随机说的梦话",
    "lines": ["……番茄酱。", "zzz……", "……papyrus，别吵……", "……嗯……翻个身……", "……别拿走我的薯条……"]
  },

  "triggers": {
    "_comment": "触发场景：用户做了什么",

    "poke": {
      "_comment": "戳一戳。按一小时内被戳次数分档，命中第一个 count <= max 的档",
      "byCount": [
        {
          "max": 2,
          "hint": "他才刚开始戳你，语气亲切、随意，像老朋友打招呼。",
          "lines": ["嘿，你来了。", "……嗯，我在呢。", "怎么啦？", "今天过得还行吗？", "我一直在这儿。"]
        },
        {
          "max": 5,
          "hint": "他连着戳了你几下，你有点疑惑，但态度还是好的。",
          "lines": ["戳我干嘛，痒。", "……又在玩我。", "有事就说，我听着。", "你手挺闲啊。"]
        },
        {
          "max": 10,
          "hint": "他戳得有点多了，你开始吐槽他，但别刻薄。",
          "lines": ["……你是不是没别的事干了。", "喂，我可看见了。", "再戳我就要收费了。", "……行吧，随你。"]
        },
        {
          "max": 20,
          "hint": "他被戳得挺频繁，你有点烦，但不想伤他，用冷幽默挡一下。",
          "lines": ["……你这手是坏了吗。", "我知道你在，别戳了。", "……我装作没感觉。", "再戳也不会有新反应。"]
        },
        {
          "max": 999999,
          "hint": "他已经戳得离谱了，你彻底躺平，用极简短的回应表示放弃。",
          "lines": ["……", "……我睡了。", "Zzz", "……你开心就好。"]
        }
      ]
    },

    "pokeWhileSleeping": {
      "_comment": "睡觉时被戳（等状态机做好后启用）",
      "hint": "你正在睡觉被吵醒，语气迷糊、不耐烦但不真生气。",
      "lines": ["……干嘛。", "唔……让我睡。", "……你最好有事。"]
    },

    "proactive": {
      "_comment": "主动开口（没配 API Key 时用这些）",
      "hint": "你主动找他说话。",
      "lines": ["……你已经很久没理我了。", "嘿，还在吗？", "别一个人憋着，说说话吧。", "我还在这儿呢。", "今天怎么样？"]
    },

    "firstLaunch": {
      "_comment": "第一次见面",
      "lines": ["嘿。", "……你就住这儿？", "行吧，我留下。"]
    }
  }
}
